# ── Red ──────────────────────────────────────────────
OT_SUBNET=10.0.1.0/24
DMZ_SUBNET=10.0.2.0/24
ATTACKER_SUBNET=10.0.3.0/24

# ── PLC ──────────────────────────────────────────────
PLC_IP=10.0.1.10
PLC_MODBUS_PORT=502

# ── ICSSIM ───────────────────────────────────────────
PUMP_INITIAL_LEVEL=50.0      # % nivel inicial del tanque
PUMP_MAX_LEVEL=100.0
PUMP_MIN_LEVEL=0.0

# ── HELICS ───────────────────────────────────────────
HELICS_BROKER_PORT=23404
HELICS_TIME_DELTA=1.0        # segundos por paso de simulación
HELICS_STOP_TIME=300.0       # duración total en segundos

# ── GridLAB-D ────────────────────────────────────────
GRIDLABD_MODEL=gridlabd/substation_phase1.glm
