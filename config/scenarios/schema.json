{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CityLab Scenario Manifest Schema",
  "type": "object",
  "required": ["id", "title", "objectives"],
  "properties": {
    "id": {
      "type": ["string", "integer"],
      "description": "Scenario ID (e.g. '01' or 1)"
    },
    "title": {
      "type": "string",
      "description": "Human-readable scenario title"
    },
    "difficulty": {
      "type": "string",
      "enum": ["Básico", "Intermedio", "Avanzado", "Avanzada", "Profesional", "Capstone"]
    },
    "category": {
      "type": "string"
    },
    "seed_scope": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Scopes influenced by session seed (e.g. unit_ids, flags, offsets)"
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "desc", "check"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^FLAG_[0-9A-Za-z_-]+$"
          },
          "desc": {
            "type": "string"
          },
          "points": {
            "type": "integer",
            "minimum": 0
          },
          "check": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["http_status", "historian_condition", "scada_sector_status", "siem_alert", "openflow_rule"]
              },
              "url": { "type": "string" },
              "expect": { "type": ["integer", "string", "number", "boolean", "object"] },
              "query": { "type": "string" },
              "window_s": { "type": "number" },
              "sector": { "type": "string" },
              "field": { "type": "string" },
              "rule": { "type": "string" },
              "rule_id": { "type": "string" },
              "switch": { "type": "string" },
              "pattern": { "type": "string" }
            },
            "additionalProperties": true
          }
        }
      }
    }
  },
  "additionalProperties": true
}
